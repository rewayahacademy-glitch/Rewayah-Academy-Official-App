{
  "permissions": {
    "allow": [
      "mcp__Supabase",
      "mcp__Supabase__list_projects",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__query_logs",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__list_migrations",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__get_file_contents",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__get_event",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__create_session",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__Gmail__search_threads",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__get_message",
      "mcp__Gmail__send_message",
      "mcp__Gmail__create_draft",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/demarrage.sh\"",
            "timeout": 360
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Monitor|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "P=; for c in python3 python py; do command -v \"$c\" >/dev/null 2>&1 && \"$c\" -c 'import json' >/dev/null 2>&1 && { P=$c; break; }; done; [ -n \"$P\" ] || { echo 'Garde-fou : Python introuvable, action refusée par prudence' >&2; exit 2; }; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde.py\"; rc=$?; [ $rc -eq 0 ] && exit 0; [ $rc -eq 2 ] || echo \"Garde-fou : échec du contrôle (code $rc), action refusée par prudence\" >&2; exit 2",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/zones_apres.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
