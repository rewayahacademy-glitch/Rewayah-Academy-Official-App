# Secrets — jamais versionné
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.keystore
*.jks
secrets/
keys/
dart_define.json
!dart_define.example.json

# Supabase CLI
supabase/.temp/
supabase/.branches/

# Flutter / Dart
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub/
.pub-cache/
*.iml
# Le code genere (drift, riverpod, slang) est VERSIONNE : la CI lance
# `dart analyze` sans etape de generation prealable, et un diff non vide
# apres regeneration signale une divergence.

