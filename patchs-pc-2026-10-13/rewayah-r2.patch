+            Ecart.vXs,
+            Text(
+              t.compte.identifiantEnfant(
+                identifiant: enfant.identifiantImmuable,
+              ),
+            ),
+            Ecart.vXs,
+            Text(
+              enfant.mode == InterfaceMode.enfant
+                  ? t.compte.modeEnfant
+                  : t.compte.modeStandard,
+            ),
