+}
+
+class _EnfantResume extends StatelessWidget {
+  const _EnfantResume({required this.enfant});
+
+  final EleveDuFoyer enfant;
+
+  @override
+  Widget build(BuildContext context) => Row(
+    children: <Widget>[
+      AvatarTile(prenom: enfant.prenom),
+      Ecart.hXl,
+      Expanded(
